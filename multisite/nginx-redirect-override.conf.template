server {
	listen  80;
	server_name {{BARE_DOMAIN}};
	return  301 https://{{WWW_DOMAIN}}$request_uri;
}

server {
	listen  443;
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_ciphers 'ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-SHA384:ECDHE-RSA-AES256-SHA384:ECDHE-ECDSA-AES128-SHA256:ECDHE-RSA-AES128-SHA256';
	ssl_prefer_server_ciphers on;
	ssl_session_timeout 5m;
	ssl_session_cache shared:SSL:50m;
	ssl_session_tickets off;
	ssl_certificate /etc/nginx/certs/{{CERT_NAME}}.crt;
	ssl_certificate_key /etc/nginx/certs/{{CERT_NAME}}.key;
	server_name {{BARE_DOMAIN}};
	return  301 https://{{WWW_DOMAIN}}$request_uri;
}

server {
	server_name {{WWW_DOMAIN}};
	listen 80 ;
	return 301 https://{{WWW_DOMAIN}}$request_uri;
}

server {
	server_name {{WWW_DOMAIN}};
	listen 443 ssl ;
	http2 on;
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_ciphers 'ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-SHA384:ECDHE-RSA-AES256-SHA384:ECDHE-ECDSA-AES128-SHA256:ECDHE-RSA-AES128-SHA256';
	ssl_prefer_server_ciphers on;
	ssl_session_timeout 5m;
	ssl_session_cache shared:SSL:50m;
	ssl_session_tickets off;
	ssl_certificate /etc/nginx/certs/{{CERT_NAME}}.crt;
	ssl_certificate_key /etc/nginx/certs/{{CERT_NAME}}.key;
	ssl_stapling on;
	ssl_stapling_verify on;
	ssl_trusted_certificate /etc/nginx/certs/{{CERT_NAME}}.chain.pem;
	location / {
		proxy_pass http://{{BACKEND_UPSTREAM}}/;
	}
	location /ee-admin/ {
		proxy_pass http://{{BACKEND_UPSTREAM}};
		auth_basic      "Restricted {{WWW_DOMAIN}} Admin Tools";
		auth_basic_user_file    /etc/nginx/htpasswd/default_admin_tools;
		include /etc/nginx/vhost.d/default_acl;
	}
}